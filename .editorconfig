# Editor settings shared by everyone working on the project (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
