# Settings that differ between computers. Copy this file to backend/.env and fill in what you need.
# Everything is optional: with an empty value the backend uses the default shown in the comment.
# backend/.env is ignored by git. Never commit real passwords or keys.

# Mode
# DEMO_MODE=true runs the automations on short demo timings (minutes instead of hours).
DEMO_MODE=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# The CRM owner: the first admin account. Without CRM_OWNER_PASSWORD a random first password is written once to
# backend/data/initial-admin-password.txt and must be changed at the first sign-in (recommended).
CRM_OWNER_EMAIL=admin@xeducation.in
CRM_OWNER_NAME=Admin
CRM_OWNER_PASSWORD=

# Sign-in tokens. Empty: a random signing secret is made once and kept in the database.
JWT_SECRET=
LEARNER_TOKEN_HOURS=168
CRM_TOKEN_HOURS=12
OTP_EXPIRY_MINUTES=10

# Outbound email via Brevo REST API (recommended for cloud hosts like Render):
BREVO_API_KEY=
EMAIL_FROM=

# Alternatively, email through Gmail (an app password, not the account password). Empty: emails and sign-up codes
# are written to the backend window and backend/data/logs/app.log instead of being sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Another mail server instead of Gmail (Outlook, Zoho, your host's SMTP): its address, port and security (ssl,
# starttls, or none for a local relay that needs no password). Empty: Gmail (smtp.gmail.com, 465, ssl).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=

# Gemini writes the message drafts and answers the CRM assistant. Empty: built-in templates and rules are used.
GEMINI_API_KEY=
GEMINI_MODEL=

# Addresses of the three parts (change them only when you use other ports or a server)
PUBLIC_SITE_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
API_URL=http://127.0.0.1:8000
# A JSON list of the browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Background work. SIMULATION_ENABLED=false keeps the simulated learners off whatever the dashboard says.
SCHEDULER_ENABLED=true
SIMULATION_ENABLED=

# File locations. Empty: everything is kept in backend/data (database, models, logs).
DATA_DIR=
